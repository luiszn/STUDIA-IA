# ==========================================================================
# STUDIA AI — environment template
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ==========================================================================

# ---------------------------- General -------------------------------------
APP_ENV=development
APP_NAME="STUDIA AI"
LOG_LEVEL=INFO
# Comma separated list. Vite dev server proxy uses the first entry.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------- Security -----------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-0000000000000000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------- Database -----------------------------------
# Production / docker-compose (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://studia:studia@db:5432/studia
# Local development without PostgreSQL (SQLite):
DATABASE_URL=sqlite:///./studia.sqlite3
DB_ECHO=false

# ---------------------------- AI providers --------------------------------
# provider: ollama | openai | local
#   ollama -> local LLM through the Ollama runtime
#   openai -> any OpenAI compatible endpoint (also OpenRouter, Groq, ...)
#   local  -> deterministic offline provider so the product is demoable
#             without any external model (clearly labelled in the UI)
AI_PROVIDER=local
AI_TIMEOUT_SECONDS=120
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=10m

# OpenAI compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------- RAG / Vector store --------------------------
EMBEDDING_DIMENSIONS=768
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RAG_TOP_K=5
RAG_MIN_SCORE=0.15

# ---------------------------- Uploads -------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.txt

# ---------------------------- Frontend ------------------------------------
VITE_API_URL=http://localhost:8000/api/v1